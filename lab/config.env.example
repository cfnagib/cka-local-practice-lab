# Copy to config.env and adjust only if needed.
LAB_DIR="$HOME/Documents/CKA-Lab"
IMAGE="$LAB_DIR/images/ubuntu-24.04-server-cloudimg-amd64.img"
NETWORK="default"
MEMORY_MB=6144
VCPUS=2

BASE="cka-base"
CONTROLPLANE="cka-controlplane"
WORKER1="cka-worker1"
WORKER2="cka-worker2"

# Current DHCP addresses; these will later be replaced by stable libvirt DHCP leases.
BASE_IP="192.168.122.40"
CONTROL_IP="192.168.122.63"
WORKER1_IP="192.168.122.80"
WORKER2_IP="192.168.122.32"
SSH_USER="$USER"
BASE_MAC="52:54:00:bc:01:01"
CONTROL_MAC="52:54:00:4b:3d:0a"
WORKER1_MAC="52:54:00:d5:38:13"
WORKER2_MAC="52:54:00:fa:1d:47"
